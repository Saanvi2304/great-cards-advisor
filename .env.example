# Copy the lines you need into your own .env file (never commit .env).

# Great.cards MCP server URL (not used in Step 1; used by scripts/inspect_mcp.py)
MCP_URL="PASTE YOUR MCP URL HERE"

# LLM used to understand user questions
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY="PASTE YOUR GEMINI API KEY HERE"

# Optional: seconds to wait for the LLM before giving up (default 30)
LLM_TIMEOUT_SECONDS=30
